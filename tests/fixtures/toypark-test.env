# tests/dryrun.sh variant: the toypark1234 fresh-install test settings (test port, throwaway
# bind sources under ~/quadlet-test, so none of the real ~/.ssh is mounted).
CODE_SERVER_BIND=127.0.0.1
CODE_SERVER_PORT=28443
CODE_SERVER_WORKSPACE=%h/quadlet-test/cs-workspace
CODE_SERVER_SSH_DIR=%h/quadlet-test/cs-ssh
CODE_SERVER_GITCONFIG=%h/quadlet-test/cs-gitconfig
CODE_SERVER_HOST_BIN=%h/quadlet-test/cs-bin
PI_DEFAULT_PROVIDER=openai-codex
PI_DEFAULT_MODEL=gpt-5.6-sol
CODE_SERVER_TAILSCALE=no
CODE_SERVER_TS_HOSTNAME=woow-code-server-test

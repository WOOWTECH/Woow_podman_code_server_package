# Per-host settings for code-server. scripts/install.sh copies this file to
# ~/.config/woow-code-server/woow-code-server.env (mode 0600) on the first install and renders
# the values into the Quadlet units. Edit that copy, then re-run install.sh: a changed value
# restarts the container, an unchanged re-run restarts nothing.
#
# Plain KEY=VALUE lines: no quotes, no `export`, no trailing comments, no spaces.
# The login password is NOT here: it is the podman secret code-server-config
# (scripts/show-password.sh prints it).

# Publish address and port. Loopback by default: use an SSH port-forward, the tailscale
# sidecar below or a proxy on this host. A LAN IP or 0.0.0.0 exposes the password prompt over
# plain HTTP to that network, and the ACP chat webview will not render there.
CODE_SERVER_BIND=127.0.0.1
CODE_SERVER_PORT=18443

# Host paths bind-mounted into the container: an absolute path, or %h/... for the home of
# the installing user. install.sh creates missing ones (an empty file for the gitconfig).
CODE_SERVER_WORKSPACE=%h/Desktop
CODE_SERVER_SSH_DIR=%h/.ssh
CODE_SERVER_GITCONFIG=%h/.gitconfig
CODE_SERVER_HOST_BIN=%h/.local/bin

# pi's default provider and model, seeded into pi's settings.json only when it is absent.
PI_DEFAULT_PROVIDER=openai-codex
PI_DEFAULT_MODEL=gpt-5.6-sol

# Optional tailscale sidecar (tailnet HTTPS front door): yes or no. install.sh
# --with-tailscale / --without-tailscale set it. TS_HOSTNAME of that node:
CODE_SERVER_TAILSCALE=no
CODE_SERVER_TS_HOSTNAME=woow-code-server

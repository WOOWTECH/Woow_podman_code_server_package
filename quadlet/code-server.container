# code-server — browser-based VS Code with pi coding agent + ACP client wired in.
#
# Publishes on 0.0.0.0:8443 with a shared PASSWORD (set below). The trust
# boundary is "anything on this LAN with the password"; do not expose this
# port past a trusted network without an authenticating proxy in front.
#
# Runs alongside Woow_podman_pi_agent_package: both containers mount the
# same external `pi-agent-data` podman volume, so a session started under
# pi-web is visible in code-server's ACP panel and vice versa. That volume
# is created by the pi-agent-package quadlet — if pi-agent-package is not
# installed on this host, `podman volume create pi-agent-data` before
# starting this unit.
[Unit]
Description=code-server — browser IDE with pi ACP adapter
Documentation=https://github.com/WOOWTECH/Woow_podman_code_server_package
After=network-online.target podman.socket
Wants=network-online.target
Requires=podman.socket

[Container]
ContainerName=code-server
Image=localhost/woow-code-server:latest

# Locally-built image; a Quadlet default of `Pull=missing` would send it
# looking for the tag on a registry that never got a push and fail every
# start after a rebuild pattern change. AutoUpdate=local pairs the two:
# tracks the local image tag rather than a registry digest.
Pull=never
AutoUpdate=local

# LAN-published on 8443. code-server internally binds 8080 (its default);
# the mapping is fixed here so healthchecks + docs don't split-brain on
# which port to talk to.
PublishPort=0.0.0.0:8443:8080

# Workspace: the invoking user's ~/Desktop. Files edited in code-server
# land back on the host owned by uid 1000, so a git push from the host
# terminal against the same repo works without permission gymnastics.
Volume=/home/woowtechopenclaw/Desktop:/workspace:rw

# Shared pi-agent state: external volume from Woow_podman_pi_agent_package.
# When pi-code runs, it re-scopes HOME to /data/pi-agent/home so pi's
# sessions/skills/models all land here and are seen by pi-web and OD too.
Volume=pi-agent-data.volume:/data/pi-agent

# Host git identity, read-only. Enough for `git commit` to attribute
# correctly and `git push` over SSH to find the deploy key.
Volume=/home/woowtechopenclaw/.ssh:/home/coder/.ssh:ro
Volume=/home/woowtechopenclaw/.gitconfig:/home/coder/.gitconfig:ro

# Host CLI tools — same trick OD uses. Anything the invoking user
# `npm install -g`'d on the host (claude, aider, ...) is on PATH here.
Volume=/home/woowtechopenclaw/.local/bin:/mnt/host-local-bin:ro

# Rootless podman + userns keep-id: without this, `coder` (uid 1000 inside)
# maps to a subuid on the host (~100999) and cannot read/write anything
# owned by the invoking host user (uid 1000). The pi-agent-data volume
# above is created and populated by the sibling pi-agent-package running
# as host uid 1000, so pi-code writes to /data/pi-agent/settings.json.lock
# fail with EACCES until we tell the userns to keep the mapping identical.
# OD's compose does the same for its `open-design` user (uid 1001).
UserNS=keep-id:uid=1000,gid=1000

# --- Environment ---------------------------------------------------------
Environment=PASSWORD=woowtech
Environment=SUDO_PASSWORD=woowtech
Environment=TZ=Asia/Taipei
Environment=DEFAULT_WORKSPACE=/workspace
Environment=PATH=/mnt/host-local-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PI_TELEMETRY=0
Environment=PI_SKIP_VERSION_CHECK=1

# --- Working directory ---------------------------------------------------
# The upstream entrypoint hardcodes `code-server --bind-addr 0.0.0.0:8080
# . "$@"` — the `.` is a positional folder arg that code-server prefers
# over subsequent ones, so passing /workspace after it via Exec= is
# silently ignored (took a live browser test to catch this; the CLI
# accepts multiple folders and picks the first one). Setting WORKDIR to
# /workspace makes `.` resolve to /workspace inside the container, so
# the entrypoint's own arg pins the default folder without us needing
# to override its ENTRYPOINT/CMD.
WorkingDir=/workspace

# --- HTTPS decision (documented, NOT enabled here) -----------------------
# We tried Exec=--cert to give code-server self-signed HTTPS on first boot.
# It DIDN'T solve the ACP chat webview:
#
#   - Browser page load: user clicks "Advanced -> Proceed to <ip> (unsafe)"
#     once, page loads fine.
#   - ServiceWorker registration for the webview host: browser uses the OS
#     trust store, NOT the per-tab "temp accept". SW registration fails
#     with `SecurityError: An SSL certificate error occurred when fetching
#     the script`. VS Code webviews are all delivered via that SW, so the
#     ACP chat panel stays blank.
#
# The trust boundary that lets webviews load is either:
#   (a) A cert the OS already trusts (Let's Encrypt via a public-DNS
#       domain, or a locally-issued cert added to each user's OS trust
#       store via `mkcert -install` etc), OR
#   (b) Access via localhost / 127.0.0.1 — always a secure context.
#
# Since (a) is out-of-scope for this addon (and would depend on the site's
# DNS / cert story), we ship plain HTTP LAN by default and document the
# trade-off in README.md#security. Sidebar tree + status bar + connection
# to pi work over plain HTTP; only the chat webview needs trusted TLS.
#
# When you're ready to enable HTTPS, front this container with a reverse
# proxy that has a trusted cert (NPM + Let's Encrypt, nginx + mkcert, etc)
# and change PublishPort= below to 127.0.0.1:8443:8080 so the plain-HTTP
# port is not directly reachable.

# --- Sandboxing ----------------------------------------------------------
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target

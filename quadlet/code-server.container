# code-server: browser-based VS Code with the pi coding agent + ACP client wired in.
#
# Rendered by scripts/install.sh from ~/.config/woow-code-server/woow-code-server.env (the
# double-at tokens are listed in quadlet/render-vars). Edit the env file and re-run install.sh;
# do not edit the installed copy.
#
# Published on @@CODE_SERVER_BIND@@ only. Reach it through an SSH port-forward, the optional
# tailscale sidecar (quadlet/optional/) or a proxy on the same host; see README "Security".
#
# pi state is INTERNAL to this deployment. Nothing is shared with the pi-web or open-design
# containers: this deployment authenticates its own pi (one `pi login` inside this container)
# and its sessions are private to it. See PARITY_CONTRACT.md.
[Unit]
Description=code-server: browser IDE with pi ACP adapter
Documentation=https://github.com/WOOWTECH/Woow_podman_code_server_package

[Container]
ContainerName=code-server
# Built by scripts/install.sh from ./Containerfile. Tag = <code-server version>-<package
# revision> (the VERSION file); tests/dryrun.local.sh fails CI when it disagrees with VERSION
# or the Containerfile ARG. A locally built image never exists on a registry: Pull=never.
Image=localhost/woow-code-server:4.135.0-1
Pull=never

# code-server always listens on 8080 inside the container.
PublishPort=@@CODE_SERVER_BIND@@:@@CODE_SERVER_PORT@@:8080

# Workspace: files edited in code-server land back on the host owned by the installing user,
# so a git push from the host terminal against the same repo works.
Volume=@@CODE_SERVER_WORKSPACE@@:/workspace:rw

# Host git identity and SSH keys, read-only. .gitconfig lands at git's SYSTEM path, not
# ~/.gitconfig, on purpose: pi-code re-points HOME at the state volume, so a ~/.gitconfig was
# invisible to the ACP panel's pi (it committed as nobody while the terminal committed as the
# user), and a read-only single-file bind over ~/.gitconfig made `git config --global` fail
# with "Device or resource busy". At /etc/gitconfig the identity applies whatever HOME is.
Volume=@@CODE_SERVER_SSH_DIR@@:/home/coder/.ssh:ro
Volume=@@CODE_SERVER_GITCONFIG@@:/etc/gitconfig:ro

# Host CLI tools: anything the user `npm install -g`'d on the host is on PATH here.
Volume=@@CODE_SERVER_HOST_BIN@@:/mnt/host-local-bin:ro

# Deployment-private state. Unchanged volume names, so existing hosts adopt their data. The pi
# volume is seeded from /opt/pi-agent-skel at first mount (podman copies image content into an
# empty named volume).
Volume=woow-code-server-pi.volume:/data/pi-agent
Volume=woow-code-server-ide.volume:/home/coder/.local/share/code-server/User

# Map the installing host user (any uid) to the image's `coder` (uid 1000). Without it coder
# maps to a subuid and cannot read or write the host binds, and pi's settings.json.lock on the
# state volume would be owned by an unmapped uid.
UserNS=keep-id:uid=1000,gid=1000

# Password: a YAML config (auth: password, password, cert: false) in the podman secret
# code-server-config, created by install.sh. code-server reads $CODE_SERVER_CONFIG. As a
# mount-type secret it never appears in `podman inspect`, the unit or the create command.
Secret=code-server-config,type=mount,target=/run/secrets/code-server-config.yaml,uid=1000,gid=1000,mode=0400
Environment=CODE_SERVER_CONFIG=/run/secrets/code-server-config.yaml

Environment=TZ=Asia/Taipei
Environment=PATH=/mnt/host-local-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PI_AGENT_DATA_DIR=/data/pi-agent
Environment=PI_CODING_AGENT_DIR=/data/pi-agent
Environment=PI_TELEMETRY=0
Environment=PI_SKIP_VERSION_CHECK=1
# Seeded into pi's settings.json by pi-seed only when that file is absent.
Environment=PI_DEFAULT_PROVIDER=@@PI_DEFAULT_PROVIDER@@
Environment=PI_DEFAULT_MODEL=@@PI_DEFAULT_MODEL@@

# The upstream entrypoint runs `code-server --bind-addr 0.0.0.0:8080 .`, and code-server
# prefers that positional `.` over any folder passed later via Exec=. Setting the working
# directory is what makes `.` resolve to /workspace.
WorkingDir=/workspace

# Health lives in the unit, so it no longer depends on building with --format=docker to keep
# the Containerfile HEALTHCHECK. systemd/code-server-health.timer re-runs it every 30 s.
HealthCmd=curl -sf http://127.0.0.1:8080/healthz
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=30s
HealthRetries=3

# sudo cannot escalate inside (no SUDO_PASSWORD is set, on purpose). Install what the image
# needs in the Containerfile.
NoNewPrivileges=true

# HTTPS, documented and not enabled here: `code-server --cert` alone does not make the ACP chat
# webview work, because VS Code delivers webviews through a service worker that only
# registers on an origin the OS trusts (or on localhost, always a secure context). Hence the
# loopback default plus an SSH port-forward, or a trusted front door such as the optional
# tailscale sidecar. A reverse proxy must forward a Host/Origin matching what the browser used,
# or code-server 403s the WebSocket upgrade.

[Service]
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not
# trap it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target

# Internal, deployment-private pi-agent state (login, sessions, skills). Not shared with any
# sibling package. VolumeName= keeps the existing name, so hosts that already run code-server
# adopt their data instead of getting a new systemd-* volume.
[Volume]
VolumeName=woow-code-server-pi-data
Label=app=woow-code-server
Label=io.woowtech.app=woow-code-server

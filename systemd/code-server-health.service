[Unit]
Description=Refresh code-server container health state
Documentation=https://github.com/WOOWTECH/Woow_podman_code_server_package
After=code-server.service

[Service]
Type=oneshot
# A silent no-op when the container is not there. This unit never starts the container; it
# only re-runs its healthcheck so `podman ps` shows the current state between the transient
# health timer's ticks. Bare `podman`: systemd resolves it on its fixed search path.
ExecCondition=podman container exists code-server
ExecStart=podman healthcheck run code-server
